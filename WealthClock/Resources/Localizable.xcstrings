    "1 = 毫无困难,7 = 非常难。文献显示这只影响悲观情景。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 = effortless, 7 = very hard. Research says this only affects the pessimistic scenario."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 = 毫無困難,7 = 非常難。文獻顯示這只影響悲觀情境。"
          }
        }
      }
    },
    "10 万以下": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 100k"
          }
        },
        "zh-Hant": {

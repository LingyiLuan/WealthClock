          "stringUnit": {
            "state": "translated",
            "value": "· 沙盤:拉動儲蓄率與習慣,即時看年齡變化"
          }
        }
      }
    },
    "“买单只公司的股票,通常比买一只股票基金更安全。”这句话:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Buying a single company's stock is usually safer than a stock fund.” This statement is:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「買單一公司的股票,通常比買一檔股票基金更安全。」這句話:"
          }
        }
      }
    },
    "三情景": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three scenarios"
          }
